@@ -24,6 +24,72 @@
 #include <fcntl.h>
 #include "common.h"
 #include "streams/file_stream.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <errno.h>
+#include <termios.h>
+// pty API (declared here, the core is not built with _XOPEN_SOURCE)
+int posix_openpt(int flags); int grantpt(int fd); int unlockpt(int fd); char *ptsname(int fd);
+void cfmakeraw(struct termios *t);
+
+// Minimal GBA UART emulation (SuperFW debugging): the link port UART is
+// connected to a host pseudo-terminal, whose path is written to ./uart.pty.
+static int uart_fd = -2;          // -2: not initialized, -1: unavailable
+static int uart_rx = -1;          // Pending received byte (-1: none)
+
+static int uart_host_fd(void) {
+  if (uart_fd == -2) {
+    uart_fd = posix_openpt(O_RDWR | O_NOCTTY);
+    if (uart_fd >= 0 && !grantpt(uart_fd) && !unlockpt(uart_fd)) {
+      fcntl(uart_fd, F_SETFL, fcntl(uart_fd, F_GETFL) | O_NONBLOCK);
+      // Raw mode (no echo), or the GBA would read back what it sends.
+      int sfd = open(ptsname(uart_fd), O_RDWR | O_NOCTTY);
+      if (sfd >= 0) {
+        struct termios t;
+        tcgetattr(sfd, &t);
+        cfmakeraw(&t);
+        tcsetattr(sfd, TCSANOW, &t);
+        close(sfd);
+      }
+      FILE *f = fopen("uart.pty", "w");
+      if (f) { fprintf(f, "%s\n", ptsname(uart_fd)); fclose(f); }
+      fprintf(stderr, "UART emulation on %s\n", ptsname(uart_fd));
+    }
+    else
+      uart_fd = -1;
+  }
+  return uart_fd;
+}
+
+static int uart_mode_enabled(void);
+
+// Called before the CPU reads SIOCNT / SIODATA8.
+static void uart_emu_read(u32 reg) {
+  if (!uart_mode_enabled() || uart_host_fd() < 0)
+    return;
+  if (uart_rx < 0) {
+    unsigned char c;
+    if (read(uart_fd, &c, 1) == 1)
+      uart_rx = c;
+  }
+  u16 siocnt = io_registers[REG_SIOCNT];
+  siocnt &= ~0x0030;                       // TX never full
+  if (uart_rx < 0)
+    siocnt |= 0x0020;                      // RX empty
+  io_registers[REG_SIOCNT] = siocnt;
+  if (reg == REG_SIOMLT_SEND && uart_rx >= 0) {      // 0x12A = SIODATA8
+    io_registers[REG_SIOMLT_SEND] = uart_rx;
+    uart_rx = -1;
+  }
+}
+
+static void uart_emu_write(u16 value) {
+  if (uart_mode_enabled() && uart_host_fd() >= 0) {
+    unsigned char c = value & 0xFF;
+    while (write(uart_fd, &c, 1) < 0 && errno == EAGAIN)
+      usleep(100);
+  }
+}
 
