+// SDRAM dump (tests): when a file named "sdram-dump" shows up in the working
+// directory, the cart's SDRAM (32MiB, ROM space order) is written to
+// "sdram.bin" and the request file is removed. Polled once per frame.
+void supercard_sdram_dump_poll(void) {
+  FILE *f;
+  if (!(f = fopen("sdram-dump", "r")))
+    return;
+  fclose(f);
+  remove("sdram-dump");
+  if ((f = fopen("sdram.bin.tmp", "wb"))) {
+    fwrite(gamepak_buffer_SDRAM, 1, 32 * 1024 * 1024, f);
+    fclose(f);
+    rename("sdram.bin.tmp", "sdram.bin");
+  }
+}
