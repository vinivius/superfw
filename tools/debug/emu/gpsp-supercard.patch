+
+// UART mode: SIOCNT bits 12-13 set, RCNT bit 15 clear.
+static int uart_mode_enabled(void) {
+  return (io_registers[REG_SIOCNT] & 0x3000) == 0x3000 && !(io_registers[REG_RCNT] & 0x8000);
+}
