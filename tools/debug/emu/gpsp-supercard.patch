+// SD read fault injection (tests): when a file named "sd-read-fail" shows up
+// in the working directory, it holds "N K": after N more read commands, the
+// next K ones never send their data (the host times out), then reads work
+// again (and a new file can be armed).
+static bool sd_read_failing = false;
+static bool sd_read_fault(void) {
+  static int skip = -1, fails = 0;
+  if (skip < 0) {
+    FILE *f = fopen("sd-read-fail", "r");
+    if (!f)
+      return false;
+    if (fscanf(f, "%d %d", &skip, &fails) < 1 || skip < 0)
+      skip = 0;
+    if (fails <= 0)
+      fails = 1;
+    fclose(f);
+    remove("sd-read-fail");
+    fprintf(stderr, "SD fault injection: failing %d reads after %d\n", fails, skip);
+  }
+  if (skip > 0) {
+    skip--;
+    return false;
+  }
+  if (--fails <= 0)
+    skip = -1;
+  return true;
+}
