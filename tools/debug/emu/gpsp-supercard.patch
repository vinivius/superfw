+// SD write fault injection (tests): when a file named "sd-write-fail" shows
+// up in the working directory, it holds how many more data blocks are written
+// normally. Every block after that is not stored and gets a CRC error status
+// token, like a card that stopped accepting writes (until the emulator exits).
+static bool sd_write_fault(void) {
+  static int remaining = -1;
+  if (remaining < 0) {
+    FILE *f = fopen("sd-write-fail", "r");
+    if (!f)
+      return false;
+    if (fscanf(f, "%d", &remaining) != 1 || remaining < 0)
+      remaining = 0;
+    fclose(f);
+    remove("sd-write-fail");
+    fprintf(stderr, "SD fault injection: failing writes after %d blocks\n", remaining);
+  }
+  if (remaining > 0) {
+    remaining--;
+    return false;
+  }
+  return true;
+}
